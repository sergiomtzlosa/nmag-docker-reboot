# Dockerfile for Nmag core (small tarball: nmag-core)
# Based on Ubuntu 11.10 / 12.04 system dependencies as described in:
# https://nmag-project.github.io/0.2/install/install_b.html

FROM ubuntu:12.04

LABEL maintainer="Nmag Docker Project"
LABEL description="Nmag core build with system packages and sundials"

ENV DEBIAN_FRONTEND=noninteractive
ENV NMAG_CORE_VERSION=0.2.1

# 1. Update repositories to old-releases.ubuntu.com and install system dependencies
RUN sed -i -re 's/([a-z]{2}\.)?security.ubuntu.com|archive.ubuntu.com/old-releases.ubuntu.com/g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python \
        python-dev \
        wget \
        ca-certificates \
        build-essential \
        g++ \
        gcc \
        gfortran \
        make \
        m4 \
        gawk \
        zlib1g-dev \
        libreadline-dev \
        readline-common \
        libpetsc3.1-dev \
        libpetsc3.1 \
        ocaml-findlib \
        libfindlib-ocaml-dev \
        ocaml-nox \
        libqhull-dev \
        python-tables \
        python-ply \
        libscotchparmetis-dev \
        libscotchmetis-dev \
        python-py \
        python-pyvtk \
        python-numpy \
        libgsl0-dev \
        mpich2 \
        libmpich2-dev \
        patch \
        file \
        dpkg-dev \
        nano && \
    (test -f /usr/include/parmetis.h || ln -sf /usr/include/parmetis/parmetis.h /usr/include/parmetis.h 2>/dev/null || true) && \
    (test -f /usr/include/metis.h || ln -sf /usr/include/metis/metis.h /usr/include/metis.h 2>/dev/null || true) && \
    (test -f /usr/include/parmetis/parmetis.h && (grep -q "idxtype" /usr/include/parmetis/parmetis.h 2>/dev/null || sed -i '1s/^/#ifndef idxtype\ntypedef int idxtype;\n#define idxtype idxtype\n#endif\n#include <metis.h>\n/' /usr/include/parmetis/parmetis.h 2>/dev/null || true) || true) && \
    (test -f /usr/include/parmetis.h && (grep -q "idxtype" /usr/include/parmetis.h 2>/dev/null || sed -i '1s/^/#ifndef idxtype\ntypedef int idxtype;\n#define idxtype idxtype\n#endif\n#include <metis.h>\n/' /usr/include/parmetis.h 2>/dev/null || true) || true) && \
    (test -f /usr/lib/libmetis.so || ln -sf /usr/lib/libscotchmetis.so /usr/lib/libmetis.so 2>/dev/null || true) && \
    (test -f /usr/lib/libparmetis.so || ln -sf /usr/lib/libptscotchparmetis.so /usr/lib/libparmetis.so 2>/dev/null || true) && \
    (test -f /usr/lib/libpmpich.so || ln -sf /usr/lib/libmpich.so /usr/lib/libpmpich.so 2>/dev/null || true) && \
    (test -f /usr/lib/libpmpich.a || ln -sf /usr/lib/libmpich.a /usr/lib/libpmpich.a 2>/dev/null || true) && \
    ldconfig && \
    rm -rf /var/lib/apt/lists/*

# 2. Build Sundials 2.3.0 from source (required by nmag core)
RUN mkdir -p /tmp/build-sundials && \
    cd /tmp/build-sundials && \
    wget --no-check-certificate https://github.com/fangohr/nmag-releases/raw/master/0.2/all/nmag-0.2.1.tar.gz -O /tmp/nmag-all.tar.gz && \
    (tar -xzf /tmp/nmag-all.tar.gz --wildcards --wildcards-match-slash "*pkgs/sundials-2.3.0.tar.gz" -O > sundials-2.3.0.tar.gz || \
     tar -xzf /tmp/nmag-all.tar.gz --wildcards "*/pkgs/sundials-2.3.0.tar.gz" -O > sundials-2.3.0.tar.gz) && \
    test -s sundials-2.3.0.tar.gz && \
    rm -f /tmp/nmag-all.tar.gz && \
    tar -xzvf sundials-2.3.0.tar.gz && \
    cd sundials-2.3.0 && \
    F77=gfortran ./configure --prefix=/usr/local --enable-shared && \
    make && \
    make install && \
    rm -rf /tmp/build-sundials && \
    ldconfig

# 3. Create unprivileged nmag user
RUN useradd -m -s /bin/bash -u 1000 nmag

# 4. Download and unpack nmag-core
WORKDIR /home/nmag
RUN wget --no-check-certificate https://github.com/fangohr/nmag-releases/raw/master/0.2/core/nmag-core-${NMAG_CORE_VERSION}.tar.gz && \
    tar -xzvf nmag-core-${NMAG_CORE_VERSION}.tar.gz && \
    rm nmag-core-${NMAG_CORE_VERSION}.tar.gz && \
    python -c "path='/home/nmag/nmag-core-${NMAG_CORE_VERSION}/src/petsc_stubs.c'; data=open(path).read(); open(path,'w').write(data.replace('#include <parmetis.h>', '#include <metis.h>\n#include <parmetis.h>\n#ifndef idxtype\ntypedef int idxtype;\n#define idxtype idxtype\n#endif\n'))" && \
    chown -R nmag:nmag /home/nmag/nmag-core-${NMAG_CORE_VERSION}

# 5. Configure and build nmag core
# Set MPI environment variables to allow running in Docker build environment
ENV OMPI_MCA_orte_tmpdir_base=/tmp \
    OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
    OMPI_MCA_btl_vader_single_copy_mechanism=none \
    OMPI_MCA_plm_rsh_agent=sh

RUN su - nmag -c "export OMPI_MCA_orte_tmpdir_base=/tmp && \
    export OMPI_ALLOW_RUN_AS_ROOT=1 && \
    export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 && \
    export OMPI_MCA_btl_vader_single_copy_mechanism=none && \
    export OMPI_MCA_plm_rsh_agent=sh && \
    cd /home/nmag/nmag-core-${NMAG_CORE_VERSION} && python configure.py && make && make install"

# 6. Expose binaries
RUN ln -sf /home/nmag/nmag-core-${NMAG_CORE_VERSION}/bin/* /usr/bin/ && \
    ln -sf /home/nmag/nmag-core-${NMAG_CORE_VERSION}/bin/* /usr/local/bin/

# 7. Configure MPD secret files for MPICH2 (/etc/mpd.conf and user configs)
RUN echo "MPD_SECRETWORD=nmag_secret_pass" > /etc/mpd.conf && \
    chown root:root /etc/mpd.conf && \
    chmod 600 /etc/mpd.conf && \
    echo "MPD_SECRETWORD=nmag_secret_pass" > /home/nmag/.mpd.conf && \
    chown nmag:nmag /home/nmag/.mpd.conf && \
    chmod 600 /home/nmag/.mpd.conf && \
    cp /etc/mpd.conf /root/.mpd.conf && \
    chmod 600 /root/.mpd.conf

# 8. Setup /io directory for user bind mounts
RUN mkdir -p /io && chown -R 1000:1000 /io

COPY entrypoint.sh /home/nmag/entrypoint.sh
RUN chmod +x /home/nmag/entrypoint.sh

USER nmag
WORKDIR /io

ENV USER=nmag \
    HOME=/home/nmag \
    PATH=/home/nmag/nmag-core-${NMAG_CORE_VERSION}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/usr/local/lib:/usr/lib

ENTRYPOINT ["/home/nmag/entrypoint.sh"]
CMD ["/bin/bash"]
